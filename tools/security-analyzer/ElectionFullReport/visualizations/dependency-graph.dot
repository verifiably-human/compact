digraph CircuitDependencies {
  rankdir=TB;
  bgcolor="#FFFFFF";
  fontcolor="#000000";
  node [shape=box, style=filled, fontname="Arial", fontsize=10, fontcolor="#000000"];
  edge [fontname="Arial", fontsize=8, fontcolor="#000000"];

  label="Circuit Dependency Graph\nContract: election.compact\nCircuits: 5 | Largest k: 15";
  labelloc="t";
  fontsize=14;

  "add_voter" [label="add_voter\nk=13 (≤ 8,192 rows)", fillcolor="#FFD700", color="#333333"];
  "advance" [label="advance\nk=13 (≤ 8,192 rows)", fillcolor="#FFD700", color="#333333"];
  "set_topic" [label="set_topic\nk=13 (≤ 8,192 rows)", fillcolor="#FFD700", color="#333333"];
  "vote$commit" [label="vote$commit\nk=15 (≤ 32,768 rows)", fillcolor="#FFA500", color="#333333"];
  "vote$reveal" [label="vote$reveal\nk=14 (≤ 16,384 rows)", fillcolor="#FFA500", color="#333333"];


  note [shape=note, fillcolor="#FFFFFF", color="#333333", fontcolor="#000000",
        label="No inter-circuit dependencies detected.\nCircuits are independent or call external library functions."];
}
