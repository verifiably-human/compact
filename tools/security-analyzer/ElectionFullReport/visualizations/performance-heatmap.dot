digraph PerformanceHeatmap {
  rankdir=TB;
  bgcolor="#FFFFFF";
  fontcolor="#000000";
  node [shape=box, style=filled, fontname="Arial", fontsize=10, fontcolor="#000000"];
  edge [fontname="Arial", fontsize=8, fontcolor="#000000"];

  label="Circuit Size Heatmap\nContract: election.compact\nLargest k: 15 (proving time roughly doubles per step of k)";
  labelloc="t";
  fontsize=14;

  "vote$commit" [label="vote$commit\nk=15 (≤ 32,768 rows)\nk source: zkir-v2", fillcolor="#FFA500", color="#333333"];
  "vote$reveal" [label="vote$reveal\nk=14 (≤ 16,384 rows)\nk source: zkir-v2", fillcolor="#FFA500", color="#333333"];
  "add_voter" [label="add_voter\nk=13 (≤ 8,192 rows)\nk source: zkir-v2", fillcolor="#FFD700", color="#333333"];
  "advance" [label="advance\nk=13 (≤ 8,192 rows)\nk source: zkir-v2", fillcolor="#FFD700", color="#333333"];
  "set_topic" [label="set_topic\nk=13 (≤ 8,192 rows)\nk source: zkir-v2", fillcolor="#FFD700", color="#333333"];
}
