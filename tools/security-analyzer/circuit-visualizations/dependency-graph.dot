digraph CircuitDependencies {
  rankdir=TB;
  bgcolor="#FFFFFF";
  node [shape=box, style=filled, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=8];

  label="Circuit Dependency Graph\nContract: counter.compact\nCircuits: 1 | Total Constraints: 9,408";
  labelloc="t";
  fontsize=14;

  "increment" [label="increment\n9,408 constraints\nK=15", fillcolor="#FFD700", color="#333333"];

  subgraph cluster_legend {
    label="Legend";
    style=filled;
    color="#333333";
    fillcolor="#FFFFFF";

    legend_low [label="Low Complexity\n(<1K constraints)", fillcolor="#90EE90", shape=box];
    legend_med [label="Medium Complexity\n(1K-10K constraints)", fillcolor="#FFD700", shape=box];
    legend_high [label="High Complexity\n(10K-100K constraints)", fillcolor="#FFA500", shape=box];
    legend_vhigh [label="Very High Complexity\n(>100K constraints)", fillcolor="#FF6347", shape=box];
  }
}
