digraph PerformanceHeatmap {
  rankdir=TB;
  bgcolor="#FFFFFF";
  fontcolor="#000000";
  node [shape=box, style=filled, fontname="Arial", fontsize=10, fontcolor="#000000"];
  edge [fontname="Arial", fontsize=8, fontcolor="#000000"];

  label="Circuit Size Heatmap\nContract: compliant-token-full.compact\nLargest k: 15 (proving time roughly doubles per step of k)";
